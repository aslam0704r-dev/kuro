# Local development only. Copy to .env.server and fill privately.
# Use Vercel Environment Variables for production; do not upload .env.server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_ORIGIN=http://localhost:8081
AUTH_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AUTH_KEY_PREFIX=kuro:local:development
PORT=8081
# Choose according to the application's actual use. MangaBaka stays disabled
# when blank; commercial/licensed use disables the MangaDex public reader.
CATALOG_USAGE=
# Set privately on the server for the scheduled catalogue refresh.
CRON_SECRET=
# Comma-separated MangaDex scanlation group UUIDs with removal requests.
MANGADEX_EXCLUDED_GROUPS=
