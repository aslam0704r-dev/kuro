{
  "name": "kuro-managed-web",
  "version": "4.4.2",
  "nativeReleaseVersion": "3.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.server server/index.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "validate:dist": "node scripts/check-dist.mjs",
    "build:catalogue": "node scripts/build-catalogue.mjs",
    "build": "npm run prepare:assets && npm run build:catalogue && npm run validate:dist && npm run validate:native",
    "release:native": "node scripts/release-native.mjs",
    "validate:native": "node scripts/validate-native.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:readable": "node scripts/audit-readable.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "cheerio": "1.2.0",
    "libarchive-wasm": "1.2.0",
    "pdfjs-dist": "6.4.299",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "esbuild": "0.28.2"
  }
}
